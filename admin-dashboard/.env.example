# RakshaSetu Admin Dashboard — Environment Configuration Example
# Copy to .env.local for local development

# Backend API base URL (Vite client-accessible)
# In local development: http://localhost:5000/api/v1
# In production on Vercel: https://<your-render-backend-domain>.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Optional dedicated WebSocket Server URL (defaults to VITE_API_URL origin if omitted)
# VITE_SOCKET_URL=http://localhost:5000

# Google Maps JavaScript API Key (Browser-restricted)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

